[Unit]
Description=voice-flow-api: the dictation pipeline over HTTP, for a phone (no auth: bind to a network you trust)
After=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/voice-flow-api
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
