#!/usr/bin/env python3
# voice-flow-dashboard — native GTK4 control panel for voice-flow.
#
# A normal (non-layer-shell) window that:
#   • shows live status (idle / listening / transcribing), polled from the
#     same runtime state files the pill uses;
#   • shows today's dictation count + words, read from history.jsonl;
#   • shows the last transcript (last-paste.txt);
#   • lets you change method / model / rewrite / pill — persisted to the
#     conf file that `voice-flow` sources on every dictation.
#
# It writes ~/.config/ormus-voice/voice-flow.conf (shell KEY=value lines).
# There is no daemon to signal: voice-flow re-reads the conf each time it
# runs, so changes take effect on the next dictation.
#
# Palette is the Ormus SSOT (ormus-platform tokens.css) shared with the
# pill: obsidian ground, gold voice, Aurum green/copper accents.
import os
import json
import glob
import subprocess
from datetime import date

import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gdk, GLib  # noqa: E402

HOME = os.path.expanduser("~")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share")), "ormus-voice")
CONF_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "ormus-voice")
CONF_PATH = os.path.join(CONF_DIR, "voice-flow.conf")
RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "ormus-voice")

REC_STATE = os.path.join(RUNTIME, "recording.state")
PILL_STATE = os.path.join(RUNTIME, "pill.state")
HISTORY = os.path.join(DATA, "history.jsonl")
LAST_PASTE = os.path.join(DATA, "last-paste.txt")
MODELS_DIR = os.path.join(DATA, "models")

DEFAULTS = {
    "VOICE_FLOW_METHOD": "auto",
    "VOICE_PASTE_MODEL": "medium.en",
    "VOICE_FLOW_REWRITE": "on",
    "VOICE_FLOW_PILL": "1",
}
METHODS = ["auto", "type", "paste"]

# Ormus palette (matches voice-flow-pill).
CSS = b"""
window { background: #0B0B0D; color: #E8E4DA; }
.h1 { font-size: 19px; font-weight: 800; color: #E0B258; letter-spacing: 1px; }
.muted { color: #8A857A; font-size: 12px; }
.section { color: #B6A98A; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
.stat { font-size: 26px; font-weight: 800; color: #E8E4DA; }
.statlabel { color: #8A857A; font-size: 11px; }
.dot { font-size: 15px; }
.dot.idle { color: #4A4740; }
.dot.listening { color: #E0B258; }
.dot.thinking { color: #D29E3D; }
.statustext { font-size: 13px; color: #E8E4DA; }
.card { background: #141318; border: 1px solid #221F1A; border-radius: 12px; padding: 14px; }
.last { color: #C9C3B6; font-size: 13px; }
button { background: #1B1A1F; color: #C9C3B6; border: 1px solid #2A2720; border-radius: 8px; padding: 6px 12px; }
button:hover { background: #232027; }
button.seg:checked { background: #D29E3D; color: #0B0B0D; font-weight: 700; border-color: #D29E3D; }
button.go { background: #D29E3D; color: #0B0B0D; font-weight: 700; }
button.go:hover { background: #E0B258; }
switch:checked { background: #7ABB9A; }
"""


def read_conf():
    cfg = dict(DEFAULTS)
    try:
        with open(CONF_PATH) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip().strip('"')
    except FileNotFoundError:
        pass
    return cfg


def write_conf(cfg):
    os.makedirs(CONF_DIR, exist_ok=True)
    lines = [
        "# voice-flow config — written by voice-flow-dashboard.",
        "# Sourced by ~/.local/bin/voice-flow on every dictation.",
    ]
    for k in DEFAULTS:
        lines.append("%s=%s" % (k, cfg.get(k, DEFAULTS[k])))
    with open(CONF_PATH, "w") as f:
        f.write("\n".join(lines) + "\n")


def available_models():
    found = []
    for p in sorted(glob.glob(os.path.join(MODELS_DIR, "ggml-*.bin"))):
        name = os.path.basename(p)[len("ggml-"):-len(".bin")]
        found.append(name)
    return found or ["base.en", "medium.en"]


def today_stats():
    """(count, words) of dictations whose ts starts with today's date."""
    today = date.today().isoformat()
    count = words = 0
    try:
        with open(HISTORY) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if str(rec.get("ts", "")).startswith(today):
                    count += 1
                    words += int(rec.get("words", 0) or 0)
    except FileNotFoundError:
        pass
    return count, words


def read_text(path, limit=600):
    try:
        with open(path) as f:
            t = f.read().strip()
        return t[:limit] + ("…" if len(t) > limit else "")
    except FileNotFoundError:
        return ""


class Dashboard(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="solutions.ormus.VoiceFlowDashboard")
        self.cfg = read_conf()

    def do_activate(self):
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        win = Gtk.ApplicationWindow(application=self, title="voice-flow")
        win.set_default_size(380, 560)
        self.win = win

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        root.set_margin_top(20); root.set_margin_bottom(20)
        root.set_margin_start(20); root.set_margin_end(20)
        win.set_child(root)

        # --- header: title + live status ---
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        title = Gtk.Label(label="voice-flow"); title.add_css_class("h1")
        title.set_halign(Gtk.Align.START); title.set_hexpand(True)
        self.dot = Gtk.Label(label="●"); self.dot.add_css_class("dot")
        self.status = Gtk.Label(label="idle"); self.status.add_css_class("statustext")
        head.append(title); head.append(self.dot); head.append(self.status)
        root.append(head)

        # --- today's stats ---
        stats_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=24)
        stats_card.add_css_class("card")
        self.stat_count = self._stat_block(stats_card, "0", "dictations today")
        self.stat_words = self._stat_block(stats_card, "0", "words today")
        root.append(stats_card)

        # --- method ---
        root.append(self._section("INJECTION METHOD"))
        self.method_btns = {}
        seg = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        seg.add_css_class("linked")
        group = None
        for m in METHODS:
            b = Gtk.ToggleButton(label=m); b.add_css_class("seg")
            if group is None:
                group = b
            else:
                b.set_group(group)
            b.set_active(self.cfg.get("VOICE_FLOW_METHOD") == m)
            b.connect("toggled", self._on_method, m)
            seg.append(b); self.method_btns[m] = b
        root.append(seg)

        # --- model ---
        root.append(self._section("MODEL"))
        self.model_btns = {}
        mseg = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        mseg.add_css_class("linked")
        mgroup = None
        for name in available_models():
            b = Gtk.ToggleButton(label=name); b.add_css_class("seg")
            if mgroup is None:
                mgroup = b
            else:
                b.set_group(mgroup)
            b.set_active(self.cfg.get("VOICE_PASTE_MODEL") == name)
            b.connect("toggled", self._on_model, name)
            mseg.append(b); self.model_btns[name] = b
        root.append(mseg)

        # --- switches: rewrite + pill ---
        root.append(self._switch_row("AI rewrite (Ollama cleanup)",
                                      self.cfg.get("VOICE_FLOW_REWRITE") != "off",
                                      self._on_rewrite))
        root.append(self._switch_row("Floating pill",
                                      self.cfg.get("VOICE_FLOW_PILL") != "0",
                                      self._on_pill))

        # --- last transcript ---
        root.append(self._section("LAST TRANSCRIPT"))
        last_card = Gtk.ScrolledWindow()
        last_card.set_vexpand(True); last_card.add_css_class("card")
        self.last = Gtk.Label(label="(nothing yet)")
        self.last.add_css_class("last")
        self.last.set_wrap(True); self.last.set_xalign(0); self.last.set_yalign(0)
        self.last.set_selectable(True)
        last_card.set_child(self.last)
        root.append(last_card)

        # --- dictate button ---
        go = Gtk.Button(label="Dictate  ·  Super+V"); go.add_css_class("go")
        go.connect("clicked", lambda *_: subprocess.Popen(["voice-flow"]))
        root.append(go)

        self._refresh()
        GLib.timeout_add(400, self._poll_status)
        GLib.timeout_add(2000, self._refresh)
        win.present()

    # --- builders ---
    def _stat_block(self, parent, value, label):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        v = Gtk.Label(label=value); v.add_css_class("stat"); v.set_halign(Gtk.Align.START)
        l = Gtk.Label(label=label); l.add_css_class("statlabel"); l.set_halign(Gtk.Align.START)
        box.append(v); box.append(l); parent.append(box)
        return v

    def _section(self, text):
        l = Gtk.Label(label=text); l.add_css_class("section")
        l.set_halign(Gtk.Align.START)
        return l

    def _switch_row(self, label, active, cb):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        l = Gtk.Label(label=label); l.set_halign(Gtk.Align.START); l.set_hexpand(True)
        sw = Gtk.Switch(); sw.set_active(active); sw.set_halign(Gtk.Align.END)
        sw.connect("state-set", cb)
        row.append(l); row.append(sw)
        return row

    # --- handlers (persist to conf) ---
    def _save(self, key, value):
        self.cfg[key] = value
        write_conf(self.cfg)

    def _on_method(self, btn, m):
        if btn.get_active():
            self._save("VOICE_FLOW_METHOD", m)

    def _on_model(self, btn, name):
        if btn.get_active():
            self._save("VOICE_PASTE_MODEL", name)

    def _on_rewrite(self, sw, state):
        self._save("VOICE_FLOW_REWRITE", "on" if state else "off")
        return False

    def _on_pill(self, sw, state):
        self._save("VOICE_FLOW_PILL", "1" if state else "0")
        return False

    # --- live polling ---
    def _poll_status(self):
        if os.path.exists(REC_STATE):
            state, text = "listening", "listening"
        else:
            pill = read_text(PILL_STATE, 32)
            if pill == "thinking" and self._pill_alive():
                state, text = "thinking", "transcribing"
            else:
                state, text = "idle", "idle"
        for c in ("idle", "listening", "thinking"):
            self.dot.remove_css_class(c)
        self.dot.add_css_class(state)
        self.status.set_text(text)
        return True

    @staticmethod
    def _pill_alive():
        return subprocess.run(["pgrep", "-f", "voice-flow-pill"],
                              capture_output=True).returncode == 0

    def _refresh(self, *_):
        count, words = today_stats()
        self.stat_count.set_text(str(count))
        self.stat_words.set_text(str(words))
        last = read_text(LAST_PASTE)
        self.last.set_text(last if last else "(nothing yet)")
        return True


if __name__ == "__main__":
    Dashboard().run(None)
