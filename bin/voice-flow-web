#!/usr/bin/env python3
# voice-flow-web — rich local analytics + management dashboard.
#
# The Wispr-class front-end: stats, charts, streaks, history, training
# data management, engine status, settings. Everything the GTK panel
# can't comfortably render. Self-contained: python stdlib server on
# 127.0.0.1 only, inline CSS/JS, no external requests, reads the same
# flat files the rest of the stack writes.
#
#   voice-flow-web            # start (or reuse) server + open browser
#   voice-flow-web --serve    # server only, foreground
#
# Data sources: history.jsonl (counts; text only if VOICE_FLOW_LOG_TEXT=1),
# vocabulary.txt, substitutions.tsv, corrections.jsonl, backend.state,
# voice-flow.conf.
import json
import os
import re
import socket
import subprocess
import sys
import threading
import urllib.request
from collections import defaultdict
from datetime import date, datetime, timedelta
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOME = os.path.expanduser("~")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME", HOME + "/.local/share"), "ormus-voice")
CONF_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "ormus-voice")
RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "ormus-voice")

HISTORY = os.path.join(DATA, "history.jsonl")
CORRECTIONS = os.path.join(DATA, "corrections.jsonl")
VOCAB = os.path.join(CONF_DIR, "vocabulary.txt")
SUBS = os.path.join(CONF_DIR, "substitutions.tsv")
CONF = os.path.join(CONF_DIR, "voice-flow.conf")
BACKEND_STATE = os.path.join(DATA, "backend.state")

PORT = int(os.environ.get("VOICE_FLOW_WEB_PORT", "7385"))
DEFAULT_HOSTS = "127.0.0.1:8093"
CONF_KEYS = ["VOICE_FLOW_METHOD", "VOICE_PASTE_MODEL", "VOICE_FLOW_REWRITE",
             "VOICE_FLOW_PILL", "VOICE_FLOW_LOG_TEXT", "VOICE_FLOW_PARTIALS"]
TYPING_WPM = 40.0   # what the same words would cost on a keyboard
SPEAKING_WPM = 150.0


def read_history():
    rows = []
    try:
        with open(HISTORY) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rows.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
    except FileNotFoundError:
        pass
    return rows


def summary():
    rows = read_history()
    days = defaultdict(lambda: {"words": 0, "count": 0, "ms": [], "agent": 0})
    total_words = 0
    for r in rows:
        d = str(r.get("ts", ""))[:10]
        if not d:
            continue
        w = int(r.get("words", 0) or 0)
        days[d]["words"] += w
        days[d]["count"] += 1
        total_words += w
        ms = int(r.get("transcribe_ms", 0) or 0)
        if 0 < ms < 120000:
            days[d]["ms"].append(ms)
    # streak: consecutive days ending today
    streak = 0
    cur = date.today()
    while days.get(cur.isoformat(), {}).get("count", 0) > 0:
        streak += 1
        cur -= timedelta(days=1)
    # last 14 days series
    series = []
    for i in range(13, -1, -1):
        d = (date.today() - timedelta(days=i)).isoformat()
        v = days.get(d, {"words": 0, "count": 0, "ms": []})
        med = sorted(v["ms"])[len(v["ms"]) // 2] if v["ms"] else 0
        series.append({"day": d, "words": v["words"], "count": v["count"], "med_ms": med})
    today = days.get(date.today().isoformat(), {"words": 0, "count": 0, "ms": []})
    t_ms = today["ms"]
    minutes_saved = total_words / TYPING_WPM - total_words / SPEAKING_WPM
    recent = [r for r in rows[-50:] if r.get("text")]
    recent.reverse()
    return {
        "today_words": today["words"],
        "today_count": today["count"],
        "today_avg_ms": (sum(t_ms) // len(t_ms)) if t_ms else 0,
        "total_words": total_words,
        "total_count": len(rows),
        "streak": streak,
        "minutes_saved": round(minutes_saved),
        "series": series,
        "recent": recent,
    }


def training():
    vocab = []
    try:
        with open(VOCAB) as f:
            vocab = [l.strip() for l in f
                     if l.strip() and not l.strip().startswith("#")]
    except FileNotFoundError:
        pass
    subs = []
    try:
        with open(SUBS) as f:
            for l in f:
                l = l.rstrip("\n")
                if l and not l.startswith("#") and "\t" in l:
                    h, c = l.split("\t", 1)
                    subs.append({"heard": h, "canonical": c})
    except FileNotFoundError:
        pass
    corr = []
    try:
        with open(CORRECTIONS) as f:
            for l in f:
                try:
                    corr.append(json.loads(l))
                except json.JSONDecodeError:
                    continue
    except FileNotFoundError:
        pass
    return {"vocabulary": vocab, "substitutions": subs, "corrections": corr[-30:]}


def read_conf():
    cfg = {"VOICE_FLOW_METHOD": "auto", "VOICE_PASTE_MODEL": "medium.en",
           "VOICE_FLOW_REWRITE": "on", "VOICE_FLOW_PILL": "1",
           "VOICE_FLOW_LOG_TEXT": "0"}
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip().strip('"')
    except FileNotFoundError:
        pass
    return cfg


def write_conf(cfg):
    """Update the keys this page owns in place; every other line stays.

    The conf is shared: the panel writes VOICE_FLOW_EXPRESS, the listener
    reads VOICE_IDEAS_*. Rewriting from a fixed list dropped them.
    """
    os.makedirs(CONF_DIR, exist_ok=True)
    try:
        with open(CONF) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        lines = ["# voice-flow config — written by voice-flow-web/dashboard.",
                 "# Sourced by ~/.local/bin/voice-flow on every dictation."]
    seen = set()
    out = []
    for line in lines:
        key = line.split("=", 1)[0].strip() if "=" in line and not line.lstrip().startswith("#") else None
        if key in CONF_KEYS and key in cfg:
            if key not in seen:
                out.append("%s=%s" % (key, cfg[key]))
                seen.add(key)
            continue
        out.append(line)
    for k in CONF_KEYS:
        if k in cfg and k not in seen:
            out.append("%s=%s" % (k, cfg[k]))
    with open(CONF, "w") as f:
        f.write("\n".join(out) + "\n")


def hosts():
    """whisper-paste's servers in its order, with the names a person reads: VOICE_PASTE_REMOTE_HOSTS
    and VOICE_HOST_NAMES ("host=name;host=name"), the environment first, then voice-flow.conf.
    This machine's :8093 by default; a host with no name reads as its address."""
    cfg = read_conf()
    pick = lambda key: os.environ.get(key) or cfg.get(key, "")
    names = {}
    for pair in pick("VOICE_HOST_NAMES").split(";"):
        if "=" in pair:
            host, name = pair.split("=", 1)
            names[host.strip()] = name.strip()
    order = (pick("VOICE_PASTE_REMOTE_HOSTS") or DEFAULT_HOSTS).split()
    return {h: names.get(h) or ("this machine" if h.startswith(("127.", "localhost")) else h) for h in order}


def engine():
    reachable = None
    known = hosts()
    for ip, name in known.items():
        try:
            urllib.request.urlopen("http://%s/" % ip, timeout=0.5)
            reachable = name
            break
        except urllib.error.HTTPError:
            reachable = name  # server answered with an HTTP error = alive
            break
        except Exception:
            continue
    last = ""
    try:
        with open(BACKEND_STATE) as f:
            last = f.read().strip()
    except FileNotFoundError:
        pass
    if last.startswith("remote "):
        token = last.split()[1]
        last = known.get(token, last)
    elif last.startswith("local "):
        last = "local fallback (%s)" % last[6:]
    return {"reachable": reachable, "last_backend": last}


def save_training(body):
    kind, action = body.get("kind"), body.get("action")
    if kind == "vocabulary":
        terms = training()["vocabulary"]
        term = (body.get("term") or "").strip()
        if action == "add" and term and term not in terms:
            terms.append(term)
        elif action == "delete":
            terms = [t for t in terms if t != term]
        os.makedirs(CONF_DIR, exist_ok=True)
        with open(VOCAB, "w") as f:
            f.write("# Ormus Voice vocabulary — biases whisper + rewriter.\n")
            f.write("\n".join(terms) + ("\n" if terms else ""))
        return True
    if kind == "substitution":
        subs = training()["substitutions"]
        heard = (body.get("heard") or "").strip()
        canonical = (body.get("canonical") or "").strip()
        if action == "add" and heard and canonical:
            subs = [s for s in subs if s["heard"].lower() != heard.lower()]
            subs.append({"heard": heard, "canonical": canonical})
        elif action == "delete":
            subs = [s for s in subs if s["heard"].lower() != heard.lower()]
        os.makedirs(CONF_DIR, exist_ok=True)
        with open(SUBS, "w") as f:
            for s in subs:
                f.write("%s\t%s\n" % (s["heard"], s["canonical"]))
        return True
    return False


