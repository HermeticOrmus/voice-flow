<script>
const $=q=>document.querySelector(q);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
let CFG={};
async function j(u,opt){const r=await fetch(u,opt);return r.json()}
function tile(v,l){return `<div class="card tile"><div class="v">${v}</div><div class="l">${l}</div></div>`}
function tip(ev,html){const t=$("#tip");t.innerHTML=html;t.style.display="block";
t.style.left=(ev.clientX+14)+"px";t.style.top=(ev.clientY-10)+"px"}
function untip(){$("#tip").style.display="none"}

function bars(svg,s){
  const W=svg.clientWidth||900,H=180,P=26;svg.setAttribute("viewBox",`0 0 ${W} ${H}`);
  const max=Math.max(...s.map(d=>d.words),1),bw=(W-2*P)/s.length;
  let h="";
  for(let i=0;i<s.length;i++){const d=s[i],bh=Math.max(d.words?3:0,(d.words/max)*(H-46));
    const x=P+i*bw+2,y=H-26-bh;
    h+=`<rect x="${x}" y="${y}" width="${bw-4}" height="${bh}" rx="4" fill="#E0B258"
      data-d="${d.day}" data-w="${d.words}" data-c="${d.count}"/>`;
    h+=`<text x="${P+i*bw+bw/2}" y="${H-10}" text-anchor="middle">${d.day.slice(8)}</text>`;
    if(d.words&&(d.words===max||i===s.length-1))
      h+=`<text x="${P+i*bw+bw/2}" y="${y-5}" text-anchor="middle" style="fill:#E8E4DA">${d.words}</text>`}
  svg.innerHTML=h;
  svg.querySelectorAll("rect").forEach(r=>{r.addEventListener("mousemove",ev=>
    tip(ev,`<b>${r.dataset.d}</b><br>${r.dataset.w} words · ${r.dataset.c} dictations`));
    r.addEventListener("mouseleave",untip)});
}
function line(svg,s){
  const W=svg.clientWidth||900,H=140,P=26;svg.setAttribute("viewBox",`0 0 ${W} ${H}`);
  const pts=s.map((d,i)=>({x:P+i*(W-2*P)/(s.length-1),v:d.med_ms/1000,day:d.day}));
  const max=Math.max(...pts.map(p=>p.v),1);
  let h="",path="";
  pts.forEach((p,i)=>{p.y=H-24-(p.v/max)*(H-44);path+=(i?"L":"M")+p.x+","+p.y});
  h+=`<path d="${path}" fill="none" stroke="#E0B258" stroke-width="2"/>`;
  pts.forEach(p=>{if(p.v>0)h+=`<circle cx="${p.x}" cy="${p.y}" r="4" fill="#E0B258"
    data-d="${p.day}" data-v="${p.v.toFixed(1)}"/>`});
  h+=`<text x="${P}" y="${H-8}">${s[0].day.slice(5)}</text>
      <text x="${W-P}" y="${H-8}" text-anchor="end">${s[s.length-1].day.slice(5)}</text>`;
  svg.innerHTML=h;
  svg.querySelectorAll("circle").forEach(c=>{c.addEventListener("mousemove",ev=>
    tip(ev,`<b>${c.dataset.d}</b><br>${c.dataset.v}s median`));
    c.addEventListener("mouseleave",untip)});
}
async function load(){
  const s=await j("/api/summary");
  $("#tiles").innerHTML=
    tile(s.today_words,"words today")+tile(s.today_count,"dictations today")+
    tile(s.today_avg_ms?(s.today_avg_ms/1000).toFixed(1)+"s":"—","avg speed today")+
    tile(s.streak+"d","streak")+tile(s.total_words.toLocaleString(),"words all-time")+
    tile("~"+s.minutes_saved+" min","typing time saved");
  bars($("#bars"),s.series);line($("#lat"),s.series);
  const e=await j("/api/engine");
  $("#engine").innerHTML=`<span class="dot ${e.reachable?"ok":"bad"}"></span>`+
    (e.reachable?`offload live — <b>${esc(e.reachable)}</b>`:"offload unreachable — <b>local fallback</b>")+
    `<div class="note">last dictation served by: ${esc(e.last_backend||"—")}</div>`;
  const t=await j("/api/training");
  $("#vocab").innerHTML=t.vocabulary.map(v=>
    `<tr><td>${esc(v)}</td><td style="width:1%"><button class="x" onclick="delVocab('${esc(v)}')">✕</button></td></tr>`).join("")
    ||"<tr><td class='mut'>empty</td></tr>";
  $("#subs").innerHTML="<tr><th>heard</th><th>canonical</th><th></th></tr>"+
    (t.substitutions.map(x=>`<tr><td class="mut">${esc(x.heard)}</td><td>${esc(x.canonical)}</td>
     <td style="width:1%"><button class="x" onclick="delSub('${esc(x.heard)}')">✕</button></td></tr>`).join("")
    ||"<tr><td class='mut' colspan=3>none learned yet — run voice-train</td></tr>");
  if(s.recent.length){
    $("#hist").innerHTML="<table><tr><th>when</th><th>text</th><th>speed</th></tr>"+
      s.recent.map(r=>`<tr><td class="mut" style="white-space:nowrap">${esc(String(r.ts).slice(5,16).replace("T"," "))}</td>
      <td>${esc(r.text)}</td><td class="num mut">${(r.transcribe_ms/1000).toFixed(1)}s</td></tr>`).join("")+"</table>";
  }else{
    $("#hist").innerHTML=`<span class="mut">Transcript history is off — the log keeps counts only
    (words, speed), never your words. Flip “Keep transcript history” below for a Wispr-style
    history. Local file either way.</span>`;
  }
  CFG=await j("/api/config");renderSettings();
}
function renderSettings(){
  const seg=(key,opts)=>`<div class="seg">`+opts.map(o=>
    `<button class="${CFG[key]===o?"on":""}" onclick="setCfg('${key}','${o}')">${o}</button>`).join("")+`</div>`;
  const sw=(key,label,on,off)=>`<div style="margin-top:10px">${label}
    ${seg(key,[on,off])}</div>`;
  $("#settings").innerHTML=
    `<div>Injection method ${seg("VOICE_FLOW_METHOD",["auto","type","paste"])}</div>`+
    `<div style="margin-top:10px">Local fallback model ${seg("VOICE_PASTE_MODEL",["base.en","medium.en"])}</div>`+
    sw("VOICE_FLOW_REWRITE","AI rewrite","on","off")+
    sw("VOICE_FLOW_PILL","Floating pill","1","0")+
    sw("VOICE_FLOW_PARTIALS","Live partial words while speaking","1","0")+
    sw("VOICE_FLOW_LOG_TEXT","Keep transcript history (local only)","1","0");
}
async function setCfg(k,v){CFG[k]=v;await j("/api/config",{method:"POST",body:JSON.stringify(CFG)});renderSettings();load()}
async function post(b){await j("/api/training",{method:"POST",body:JSON.stringify(b)});load()}
function addVocab(){const t=$("#nv").value.trim();if(t)post({kind:"vocabulary",action:"add",term:t});$("#nv").value=""}
function delVocab(t){post({kind:"vocabulary",action:"delete",term:t})}
function addSub(){const h=$("#nh").value.trim(),c=$("#nc").value.trim();
  if(h&&c)post({kind:"substitution",action:"add",heard:h,canonical:c});$("#nh").value="";$("#nc").value=""}
function delSub(h){post({kind:"substitution",action:"delete",heard:h})}
load();setInterval(load,15000);
</script></body></html>"""


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/":
            self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        elif self.path == "/api/summary":
            self._send(200, summary())
        elif self.path == "/api/training":
            self._send(200, training())
        elif self.path == "/api/config":
            self._send(200, read_conf())
        elif self.path == "/api/engine":
            self._send(200, engine())
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0))
        try:
            body = json.loads(self.rfile.read(n) or b"{}")
        except json.JSONDecodeError:
            self._send(400, {"error": "bad json"})
            return
        if self.path == "/api/config":
            cfg = read_conf()
            for k in CONF_KEYS:
                if k in body:
                    cfg[k] = re.sub(r"[^A-Za-z0-9._-]", "", str(body[k]))[:40]
            write_conf(cfg)
            self._send(200, cfg)
        elif self.path == "/api/training":
            ok = save_training(body)
            self._send(200 if ok else 400, {"ok": ok})
        else:
            self._send(404, {"error": "not found"})


def port_open():
    with socket.socket() as s:
        return s.connect_ex(("127.0.0.1", PORT)) == 0


def main():
    url = "http://127.0.0.1:%d/" % PORT
    if "--serve" in sys.argv:
        ThreadingHTTPServer(("127.0.0.1", PORT), H).serve_forever()
        return
    if not port_open():
        t = threading.Thread(
            target=lambda: ThreadingHTTPServer(("127.0.0.1", PORT), H).serve_forever(),
            daemon=False)
        t.start()
        subprocess.Popen(["xdg-open", url])
        t.join()
    else:
        subprocess.Popen(["xdg-open", url])


if __name__ == "__main__":
    main()
