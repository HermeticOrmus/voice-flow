#!/usr/bin/env bash
# voice-agent-ollama — execute a SPOKEN COMMAND and print the answer.
#
# The agent-mode counterpart of voice-rewrite-ollama: instead of
# cleaning the transcript, the transcript IS an instruction ("draft a
# reply saying I'll be late", "translate this to Spanish: ...",
# "what's the chmod for read-only?") and stdout is the result that
# gets injected at the cursor. Invoked by `voice-flow agent`.
#
# Same contract as the rewrite scripts: stdin in, text out, failures
# fall through to echoing the input so voice paste never breaks.
#
# Configuration (env):
#   OLLAMA_HOST            single base URL — overrides the host probe
#   OLLAMA_HOSTS           space-separated URLs, first reachable wins
#   VOICE_AGENT_MODEL      ollama model tag (default llama3.2:3b)
#   VOICE_AGENT_TIMEOUT    curl --max-time in seconds (default 20 —
#                          agent answers are longer than cleanups)

set -euo pipefail

INPUT=$(cat)
[ -n "$INPUT" ] || { exit 0; }

MODEL="${VOICE_AGENT_MODEL:-llama3.2:3b}"
TIMEOUT="${VOICE_AGENT_TIMEOUT:-20}"

HOSTS="${OLLAMA_HOSTS:-http://10.10.90.145:11434 http://100.66.108.108:11434}"
HOST=""
if [ -n "${OLLAMA_HOST:-}" ]; then
    HOST="$OLLAMA_HOST"
else
    for h in $HOSTS; do
        if curl -s --connect-timeout 0.4 -m 1 "$h/api/version" >/dev/null 2>&1; then
            HOST="$h"
            break
        fi
    done
fi
[ -n "$HOST" ] || { echo "$INPUT"; exit 0; }

KEEP_ALIVE="5m"
case "$HOST" in
    *localhost*|*127.0.0.1*) : ;;
    *) KEEP_ALIVE="-1" ;;
esac

SYSTEM_PROMPT='You are a voice agent inside a dictation tool. The input is a spoken command, transcribed. Execute it and output ONLY the result — it is injected directly at the user cursor.

The input is speech: tolerate filler words, false starts, and stutters when reading the instruction. Convert spoken punctuation, numbers, and dates in any produced text to standard written forms.

You can: draft, compose, translate, summarize, expand, reformat, change tone, answer questions, produce shell commands or code when asked.

OUTPUT RULES:
1. Output ONLY the produced text or answer — no preamble, no meta-commentary, no labels, no markdown fences unless asked.
2. NEVER ask clarifying questions — make the reasonable choice and produce the result.
3. For direct questions, output just the answer.
4. Keep it as short as the instruction allows.'

BODY=$(jq -n \
    --arg model "$MODEL" \
    --arg system "$SYSTEM_PROMPT" \
    --arg prompt "$INPUT" \
    --arg keep "$KEEP_ALIVE" \
    '{
        model: $model,
        system: $system,
        prompt: $prompt,
        stream: false,
        keep_alive: ($keep | tonumber? // $keep),
        options: { temperature: 0.2, num_ctx: 4096 }
    }')

RESP=$(curl -sS -m "$TIMEOUT" -X POST "$HOST/api/generate" \
    -H "content-type: application/json" \
    -d "$BODY" 2>/dev/null || true)

ANSWER=$(echo "$RESP" | jq -r '.response // empty' 2>/dev/null \
    | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
if [ -z "$ANSWER" ]; then
    echo "$INPUT"
    exit 0
fi
echo "$ANSWER"
