#!/usr/bin/env python3
# voice-flow-pill — Wispr-Flow-style floating feedback pill for COSMIC.
#
# A layer-shell overlay anchored bottom-center, ALWAYS above other
# windows, that NEVER steals keyboard focus (layer-shell keyboard mode
# NONE) — essential, or the dictation target would lose focus to the
# pill and the injected text would go nowhere.
#
# It taps the microphone directly (arecord raw PCM) to drive a live
# audio-reactive waveform while listening, and reads its display state
# from a one-word state file so the `voice-flow` lifecycle can move it
# through: listening -> thinking -> done/cancel -> (fade) -> exit.
#
# WHY this is possible on Wayland: normal apps can't be always-on-top
# or edge-anchored (security). The layer-shell protocol is the
# sanctioned exception, and COSMIC implements it (its panel/dock use it).
#
# State file: $XDG_RUNTIME_DIR/ormus-voice/pill.state
#   listening | thinking | done | copied | cancel | quit
#   Agent-mode variants: listening-agent | thinking-agent (silver, not
#   gold — you always know which mode is recording).
#   Payloads after a colon:
#     listening:<forecast>      verbatim or clean — what the focused window
#                               will do to the words; drawn as a small mark
#     done:<preview>            a one-line preview of what landed
#     copied:<key> <preview>    the paste key for that window, then the preview
#     cancel:<reason>           silent | junk <logprob> | empty | hallucination
import os
import re
import sys

# gtk4-layer-shell MUST be loaded before libwayland-client or the layer
# surface silently fails to initialize and the pill maps as a normal
# window. Under PyGObject, GTK loads libwayland first, so LD_PRELOAD
# the layer-shell lib — which only takes effect at process start. Set
# the env and re-exec once (guarded against an exec loop).
def _first_existing(paths):
    for path in paths:
        if os.path.exists(path):
            return path
    return ""


_PRELOAD = _first_existing((
    "/usr/lib/libgtk4-layer-shell.so.0",
    "/usr/lib/x86_64-linux-gnu/libgtk4-layer-shell.so.0",
    "/usr/local/lib/x86_64-linux-gnu/libgtk4-layer-shell.so.0",
    "/usr/lib/liblayer-shell-preload.so",
))
_TYPELIB = _first_existing((
    "/usr/lib/girepository-1.0",
    "/usr/lib/x86_64-linux-gnu/girepository-1.0",
    "/usr/local/lib/x86_64-linux-gnu/girepository-1.0",
))
if os.environ.get("_VFP_PRELOADED") != "1":
    os.environ["_VFP_PRELOADED"] = "1"
    if _PRELOAD:
        pre = os.environ.get("LD_PRELOAD", "")
        os.environ["LD_PRELOAD"] = _PRELOAD + ((":" + pre) if pre else "")
    if _TYPELIB:
        os.environ["GI_TYPELIB_PATH"] = _TYPELIB + ":" + os.environ.get("GI_TYPELIB_PATH", "")
    os.execv(sys.executable, [sys.executable] + sys.argv)

# --- the desktop theme --------------------------------------------------
# Omarchy keeps the current theme at $XDG_STATE_HOME/omarchy/current/theme/
# colors.toml (Ormus Sun on Sun). The pill draws with seven roles; a role
# takes the first theme key that exists, else the built-in Ormus value.
# While listening the bars are the accent: the one gold thing on screen.
_BUILTIN = {
    "ground": "#0B0B0D", "ink": "#C9C3B6", "accent": "#E0B258",
    "accent_dim": "#D29E3D", "agent": "#C8D3DD", "agent_dim": "#ADBAC8",
    "ok": "#7ABB9A", "warn": "#CC6633",
}
_ROLE_KEYS = {
    "ground": ("background",), "ink": ("foreground",), "accent": ("accent",),
    "accent_dim": ("light_foreground",), "agent": ("bright_blue",),
    "agent_dim": ("blue",), "ok": ("bright_green", "green"), "warn": ("red",),
}


def _theme():
    state = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    found = {}
    try:
        with open(os.path.join(state, "omarchy", "current", "theme", "colors.toml")) as f:
            for line in f:
                m = re.match(r'^\s*([a-z_]+)\s*=\s*"(#[0-9A-Fa-f]{6})"', line)
                if m:
                    found[m.group(1)] = m.group(2).upper()
    except OSError:
        pass
    return {role: next((found[k] for k in keys if k in found), _BUILTIN[role])
            for role, keys in _ROLE_KEYS.items()}


def _rgb(hexcolor):
    return tuple(int(hexcolor[i:i + 2], 16) / 255.0 for i in (1, 3, 5))


THEME = _theme()
if "--print-theme" in sys.argv:
    for role in _ROLE_KEYS:
        print("%s=%s" % (role, THEME[role]))
    sys.exit(0)

import io
import math
import struct
import threading
import subprocess
import time
import urllib.request
import uuid
import wave
from collections import deque

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gtk, Gdk, GLib, Gtk4LayerShell as LayerShell  # noqa: E402

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
STATE_FILE = os.path.join(RUNTIME, "ormus-voice", "pill.state")

# Live partials: while listening, the pill re-transcribes its own mic
# tap every ~1.2s against the same CUDA server as the final transcript
# (Sun :8093, then sg). Feedback only — the injected text still comes
# from the stop-time pass.
PARTIALS_ON = os.environ.get("VOICE_FLOW_PARTIALS", "1") != "0"
PARTIAL_HOSTS = os.environ.get(
    "VOICE_FLOW_PARTIAL_HOSTS",
    "127.0.0.1:8093 10.10.90.145:8093 100.66.108.108:8093").split()
PARTIAL_WINDOW_S = 15      # sliding window of audio re-sent each tick
PARTIAL_TICK_S = 1.2

# Geometry: grounded rounded-rect, not a full capsule; thin bars.
if PARTIALS_ON:
    WIDTH, HEIGHT, NUM_BARS = 440, 78, 36
else:
    WIDTH, HEIGHT, NUM_BARS = 240, 60, 24
CORNER_R = 14
BAR_FRACTION = 0.42   # bar width inside its slot — thin marks, real gaps

# Colors come from THEME (the desktop's colors.toml, else the built-in
# Ormus palette). Listening is the accent, the one gold thing on screen;
# thinking is the dimmer accent (a sweep, not a glow); agent mode is a
# different metal (blue-silver) so a glance tells you whether your words
# will be transcribed or executed; done is the ok green, cancel the warn.
OBSIDIAN = _rgb(THEME["ground"])
GOLD_RIM = _rgb(THEME["accent"])
SILVER_RIM = _rgb(THEME["agent_dim"])
INK = _rgb(THEME["ink"])
COL = {
    "listening": _rgb(THEME["accent"]),
    "thinking": _rgb(THEME["accent_dim"]),
    "listening-agent": _rgb(THEME["agent"]),
    "thinking-agent": _rgb(THEME["agent_dim"]),
    "done": _rgb(THEME["ok"]),
    "copied": _rgb(THEME["accent"]),
    "cancel": _rgb(THEME["warn"]),
}
LISTEN_STATES = ("listening", "listening-agent")
THINK_STATES = ("thinking", "thinking-agent")
END_STATES = ("done", "copied", "cancel")
# Toggle-mode arecord cap in whisper-paste — the timer turns copper as
# the recording approaches it.
MAX_SECONDS = int(os.environ.get("VOICE_PASTE_MAX_SECONDS", "120"))


class Pill(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="solutions.ormus.VoiceFlowPill")
        self.state = "listening"
        self.payload = ""         # transcript preview for done/copied
        self.forecast = ""        # verbatim | clean, while listening
        self.copied_key = "Ctrl+V"
        self.partial = ""         # live partial transcript while listening
        self.listen_start = time.monotonic()
        self.levels = deque([0.0] * NUM_BARS, maxlen=NUM_BARS)
        self.pcm = deque(maxlen=PARTIAL_WINDOW_S * 16000 * 2 // 2048 + 2)
        self.phase = 0.0          # animation clock
        self.opacity = 0.0        # fade-in
        self.fading_out = False
        self._stop_audio = threading.Event()
        self._partial_host = None
        self._partial_busy = False

    def do_activate(self):
        win = Gtk.ApplicationWindow(application=self)
        win.set_default_size(WIDTH, HEIGHT)
        win.set_decorated(False)
        win.add_css_class("pill-window")

        # --- layer-shell: overlay, bottom-center, focus-proof ---
        LayerShell.init_for_window(win)
        LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
        LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.NONE)
        LayerShell.set_anchor(win, LayerShell.Edge.BOTTOM, True)
        LayerShell.set_margin(win, LayerShell.Edge.BOTTOM, 80)
        LayerShell.set_namespace(win, "voice-flow-pill")

        css = Gtk.CssProvider()
        css.load_from_data(
            b".pill-window{background:transparent;}"
        )
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self.area = Gtk.DrawingArea()
        self.area.set_content_width(WIDTH)
        self.area.set_content_height(HEIGHT)
        self.area.set_draw_func(self._draw)
        win.set_child(self.area)
        self.win = win
        win.present()

        # Drive the mic tap + animation + state polling.
        threading.Thread(target=self._audio_loop, daemon=True).start()
        if PARTIALS_ON:
            threading.Thread(target=self._partial_loop, daemon=True).start()
        GLib.timeout_add(33, self._tick)          # ~30 fps
        GLib.timeout_add(80, self._poll_state)

    # --- live mic level -> bar history ------------------------------
    def _audio_loop(self):
        # Separate raw capture from the engine's recorder; PipeWire
        # allows multiple readers of the same source.
        try:
            proc = subprocess.Popen(
                ["arecord", "-q", "-f", "S16_LE", "-r", "16000",
                 "-c", "1", "-t", "raw"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            )
        except FileNotFoundError:
            return
        chunk = 1024
        while not self._stop_audio.is_set():
            data = proc.stdout.read(chunk * 2)
            if not data:
                break
            n = len(data) // 2
            if n == 0:
                continue
            samples = struct.unpack("<%dh" % n, data[: n * 2])
            rms = math.sqrt(sum(s * s for s in samples) / n) / 32768.0
            # Perceptual boost: quiet speech still shows.
            lvl = min(1.0, (rms ** 0.5) * 2.2)
            self.levels.append(lvl)
            if PARTIALS_ON and self.state in LISTEN_STATES:
                self.pcm.append(data)
        proc.terminate()

    # --- live partials: sliding-window re-transcription ---------------
    def _find_partial_host(self):
        for h in PARTIAL_HOSTS:
            try:
                urllib.request.urlopen("http://%s/" % h, timeout=0.4)
                return h
            except urllib.error.HTTPError:
                return h          # HTTP error = server is there
            except Exception:
                continue
        return None

    def _partial_loop(self):
        self._partial_host = self._find_partial_host()
        if not self._partial_host:
            return
        while not self._stop_audio.is_set():
            time.sleep(PARTIAL_TICK_S)
            if self.state not in LISTEN_STATES or self._partial_busy:
                continue
            chunks = list(self.pcm)
            if len(chunks) * 2048 < 16000 * 2:       # need >= ~1s of audio
                continue
            self._partial_busy = True
            try:
                text = self._transcribe(b"".join(chunks))
                if text is not None and self.state in LISTEN_STATES:
                    self.partial = text
            except Exception:
                pass
            self._partial_busy = False

    def _transcribe(self, pcm):
        buf = io.BytesIO()
        with wave.open(buf, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(16000)
            w.writeframes(pcm)
        boundary = uuid.uuid4().hex
        body = b""
        for name, value in (("response_format", b"text"),):
            body += ("--%s\r\nContent-Disposition: form-data; "
                     "name=\"%s\"\r\n\r\n" % (boundary, name)).encode() + value + b"\r\n"
        body += ("--%s\r\nContent-Disposition: form-data; name=\"file\"; "
                 "filename=\"p.wav\"\r\nContent-Type: audio/wav\r\n\r\n"
                 % boundary).encode() + buf.getvalue() + b"\r\n"
        body += ("--%s--\r\n" % boundary).encode()
        req = urllib.request.Request(
            "http://%s/inference" % self._partial_host, data=body,
            headers={"Content-Type": "multipart/form-data; boundary=" + boundary})
        with urllib.request.urlopen(req, timeout=2.5) as resp:
            text = resp.read().decode("utf-8", "replace")
        # Strip whisper's non-speech annotations — feedback should be words.
        text = re.sub(r"[\[(][^\])]*[\])]", "", text)
        return " ".join(text.split())

    # --- per-frame animation ----------------------------------------
    def _tick(self):
        self.phase += 0.18
        target = 0.0 if self.fading_out else 1.0
        self.opacity += (target - self.opacity) * 0.25
        if self.fading_out and self.opacity < 0.03:
            self._stop_audio.set()
            self.quit()
            return False
        self.area.queue_draw()
        return True

    def _poll_state(self):
        try:
            with open(STATE_FILE) as f:
                raw = f.read().strip()
        except FileNotFoundError:
            raw = ""
        # "done:Hello there." → state + one-line preview payload.
        s, _, payload = raw.partition(":")
        if s == "quit":
            self.fading_out = True
        elif s in COL:
            text = " ".join(payload.split())
            if s in LISTEN_STATES:
                # The pill starts in the listening state, so the forecast
                # must land on every poll, not only on a state change.
                self.forecast, text = text, ""
            if s != self.state:
                self.state = s
                self.payload = text
                if s in LISTEN_STATES:
                    self.listen_start = time.monotonic()
                    self.pcm.clear()
                    self.partial = ""
                if s == "copied":
                    key, _, rest = self.payload.partition(" ")
                    if rest:
                        self.copied_key, self.payload = key, rest
                if s in END_STATES:
                    self._stop_audio.set()
                    # Hold longer when there's something to read: the
                    # transcript preview, or the "press Ctrl+V" cue.
                    if s == "copied":
                        hold = 2600
                    elif self.payload:
                        hold = 1600
                    else:
                        hold = 650
                    GLib.timeout_add(hold, self._begin_fade)
        return True

    def _begin_fade(self):
        self.fading_out = True
        return False

    # --- drawing -----------------------------------------------------
    def _draw(self, area, cr, w, h, *_):
        a = max(0.0, min(1.0, self.opacity))
        # grounded translucent obsidian slab (rounded rect, not capsule)
        r = CORNER_R
        cr.set_source_rgba(*OBSIDIAN, 0.88 * a)
        self._rounded(cr, 0, 0, w, h, r)
        cr.fill()

        # faint rim — silver in agent mode, gold otherwise
        rim = SILVER_RIM if self.state.endswith("-agent") else GOLD_RIM
        cr.set_source_rgba(*rim, 0.30 * a)
        self._rounded(cr, 0.5, 0.5, w - 1, h - 1, r)
        cr.set_line_width(1)
        cr.stroke()

        cr2 = COL.get(self.state, COL["listening"])

        # End states with a payload show the transcript preview instead
        # of bars — you see WHAT landed, not just that something did.
        if self.state in END_STATES and self.payload:
            label = "copied — " + self.copied_key if self.state == "copied" else None
            self._center_text(cr, w, h, self.payload, cr2, a, hint=label)
            return

        # With live partials the bars ride in the upper band and the
        # partial text gets the lower line; otherwise bars fill the pill.
        show_partial = (PARTIALS_ON and self.state in LISTEN_STATES
                        and bool(self.partial))
        band_h = h - 30 if show_partial else h
        pad = 18
        bw = (w - 2 * pad) / NUM_BARS
        mid = band_h / 2.0
        # Bars turn copper as the recording cap nears — the quiet
        # replacement for the removed timer.
        if (self.state in LISTEN_STATES
                and time.monotonic() - self.listen_start >= MAX_SECONDS - 15):
            cr2 = COL["cancel"]
        levels = list(self.levels)
        bar_w = bw * BAR_FRACTION
        for i in range(NUM_BARS):
            if self.state in LISTEN_STATES:
                lv = levels[i]
            elif self.state in THINK_STATES:
                # travelling sine "breathing" sweep
                lv = 0.35 + 0.45 * (0.5 + 0.5 * math.sin(self.phase - i * 0.5))
            else:
                lv = 0.5
            bh = max(3.0, lv * (band_h - 16))
            x = pad + i * bw + (bw - bar_w) / 2
            cr.set_source_rgba(cr2[0], cr2[1], cr2[2], (0.55 + 0.45 * lv) * a)
            self._rounded(cr, x, mid - bh / 2, bar_w, bh, bar_w / 2)
            cr.fill()

        # The forecast mark: verbatim or clean, small, top-right, in ink.
        if self.state in LISTEN_STATES and self.forecast:
            cr.select_font_face("sans-serif", 0, 0)
            cr.set_font_size(9)
            ext = cr.text_extents(self.forecast)
            cr.set_source_rgba(INK[0], INK[1], INK[2], 0.55 * a)
            cr.move_to(w - pad - ext.width, 13)
            cr.show_text(self.forecast)

        # Live partial line — the TAIL of the text (most recent words).
        if show_partial:
            cr.select_font_face("sans-serif", 0, 0)
            cr.set_font_size(12)
            t = self.partial
            while t and cr.text_extents("…" + t).width > w - 2 * pad:
                t = t[1:]
            if t != self.partial:
                t = "…" + t
            ext = cr.text_extents(t)
            cr.set_source_rgba(INK[0], INK[1], INK[2], 0.85 * a)
            cr.move_to((w - ext.width) / 2, h - 12)
            cr.show_text(t)


    def _center_text(self, cr, w, h, text, col, a, hint=None):
        cr.select_font_face("sans-serif", 0, 0)
        cr.set_font_size(13)
        pad = 16
        # Ellipsize to fit the capsule width.
        t = text
        while t and cr.text_extents(t + "…").width > w - 2 * pad:
            t = t[:-1]
        if t != text:
            t = t + "…"
        ext = cr.text_extents(t)
        base_y = h / 2 + ext.height / 2 - (6 if hint else 0)
        cr.set_source_rgba(col[0], col[1], col[2], 0.95 * a)
        cr.move_to((w - ext.width) / 2, base_y)
        cr.show_text(t)
        if hint:
            cr.set_font_size(9)
            hx = cr.text_extents(hint)
            cr.set_source_rgba(col[0], col[1], col[2], 0.60 * a)
            cr.move_to((w - hx.width) / 2, base_y + 14)
            cr.show_text(hint)

    @staticmethod
    def _rounded(cr, x, y, w, h, r):
        r = min(r, w / 2, h / 2)
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
        cr.close_path()


def main():
    # Allow a self-quitting smoke test: `voice-flow-pill --selftest`
    if "--selftest" in sys.argv:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with open(STATE_FILE, "w") as f:
            f.write("listening")
        GLib.timeout_add(1800, lambda: (open(STATE_FILE, "w").write("quit")))
    app = Pill()
    app.run(None)


if __name__ == "__main__":
    main()
