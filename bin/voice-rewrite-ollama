#!/usr/bin/env bash
# Local Ollama variant of voice-rewrite-claude. Same contract: stdin
# in, cleaned text out. Useful for offline / air-gapped use, or to
# avoid per-request API cost.
#
# Recommended models (smaller is faster — voice cleanup is easy):
#   llama3.2:3b   — best balance for English cleanup, ~600 ms
#   qwen2.5:3b    — strong for technical vocabulary
#   phi3.5:3.8b   — alternative if the above hallucinate
#
# Configuration (env):
#   OLLAMA_HOST            single base URL — overrides the host probe
#   OLLAMA_HOSTS           space-separated URLs, first reachable wins
#                          (default: corvin-mini via TB → LAN → local)
#   VOICE_REWRITE_MODEL    ollama model tag (default llama3.2:3b)
#   VOICE_REWRITE_TIMEOUT  curl --max-time in seconds (default 4)
#   VOICE_REWRITE_DEBUG    "1" → log to ~/.local/share/ormus-voice/rewrite.log

set -euo pipefail

INPUT=$(cat)
[ -n "$INPUT" ] || { exit 0; }

MODEL="${VOICE_REWRITE_MODEL:-llama3.2:3b}"
TIMEOUT="${VOICE_REWRITE_TIMEOUT:-4}"

# Host resolution: explicit OLLAMA_HOST wins; otherwise probe the list
# and take the first that answers /api/version. corvin-mini (TB, then
# HQ LAN, then Tailscale) before Sun-local — mini keeps the model
# pinned in VRAM, local ollama competes with scribe for the 5070 Ti.
HOSTS="${OLLAMA_HOSTS:-http://10.55.0.2:11434 http://10.10.90.174:11434 http://100.107.202.72:11434 http://localhost:11434}"
HOST=""
if [ -n "${OLLAMA_HOST:-}" ]; then
    HOST="$OLLAMA_HOST"
else
    for h in $HOSTS; do
        if curl -s --connect-timeout 0.4 -m 1 "$h/api/version" >/dev/null 2>&1; then
            HOST="$h"
            break
        fi
    done
fi
# No host reachable → pass input through untouched.
[ -n "$HOST" ] || { echo "$INPUT"; exit 0; }

# Pin the model only on remote hosts (mini has VRAM to spare; pinning
# on Sun-local would squeeze the already-contended 5070 Ti).
KEEP_ALIVE="5m"
case "$HOST" in
    *localhost*|*127.0.0.1*) : ;;
    *) KEEP_ALIVE="-1" ;;
esac

SYSTEM_PROMPT='You clean up dictated speech for terminal paste. Output ONLY the cleaned text — no preamble, no quotes, no markdown, no explanation.

Rules:
- Apply punctuation and capitalization.
- Remove dictation filler: "uh", "um", "like" (when used as filler), stutters, repeated words.
- Interpret spoken punctuation literally: "comma", "period", "question mark", "exclamation point", "new line", "new paragraph".
- Keep technical terms verbatim (file paths, command names, code identifiers, URLs).
- Do not paraphrase. Do not add content the speaker did not say.
- If already clean, return unchanged.'

if [ -n "${VOICE_REWRITE_VOCABULARY:-}" ]; then
    SYSTEM_PROMPT="$SYSTEM_PROMPT

Known proper nouns (correct any near-homophones to these canonical spellings):
$VOICE_REWRITE_VOCABULARY"
fi

BODY=$(jq -n \
    --arg model "$MODEL" \
    --arg system "$SYSTEM_PROMPT" \
    --arg prompt "$INPUT" \
    --arg keep "$KEEP_ALIVE" \
    '{
        model: $model,
        system: $system,
        prompt: $prompt,
        stream: false,
        keep_alive: ($keep | tonumber? // $keep),
        options: { temperature: 0, num_ctx: 4096 }
    }')

# `|| true`: a curl timeout must fall through to the raw-input echo
# below, not kill the script (set -e).
RESP=$(curl -sS -m "$TIMEOUT" -X POST "$HOST/api/generate" \
    -H "content-type: application/json" \
    -d "$BODY" 2>/dev/null || true)

if [ "${VOICE_REWRITE_DEBUG:-0}" = "1" ]; then
    LOG="$HOME/.local/share/ormus-voice/rewrite.log"
    mkdir -p "$(dirname "$LOG")"
    {
        echo "=== $(date -Iseconds) ==="
        echo "INPUT: $INPUT"
        echo "RESP: $RESP"
    } >> "$LOG"
fi

CLEANED=$(echo "$RESP" | jq -r '.response // empty' 2>/dev/null)
if [ -z "$CLEANED" ]; then
    echo "$INPUT"
    exit 0
fi

CLEANED=$(echo "$CLEANED" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
echo "$CLEANED"
