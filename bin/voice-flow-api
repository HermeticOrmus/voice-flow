#!/usr/bin/env python3
"""voice-flow-api: the Super+H pipeline over HTTP, for a phone. Stdlib only.

  GET  /v1/health                  200 {"status":"ok","engine":"<first reachable whisper host>"}
  POST /v1/dictate?style=<s>       body = audio (audio/wav, audio/ogg, audio/mp4), max 60 MB
       -> 200 {"text","raw","style","engine","ms":{"transcribe","rewrite"}}

It does not re-implement the pipeline: the take is converted to 16 kHz mono WAV and handed to
`whisper-paste --file`, the same engine Super+H runs (server list, junk gate, hallucination
filter, voice-substitute, rewrite). Only the typing is missing.

No authentication: anyone who can reach the bind address can dictate. Bind it to loopback and
to the address of a private network you trust, never to a public one.

Config (voice-flow.conf, same file voice-flow reads; the environment wins):
  VOICE_FLOW_API_BIND    space-separated addresses (default 127.0.0.1)
  VOICE_FLOW_API_PORT    default 8097
  VOICE_FLOW_API_MAX_BYTES  upload cap (default 62914560, 60 MB)
  VOICE_FLOW_EXPRESS     default style (prompt|formal|casual|verbatim; default prompt)
  VOICE_FLOW_REWRITE     off = never rewrite
  VOICE_FLOW_LOG_TEXT    1 = history.jsonl also carries the text (default: counts only)
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

STYLES = ("prompt", "formal", "casual", "verbatim")
TYPES = {"audio/wav": "wav", "audio/x-wav": "wav", "audio/wave": "wav", "audio/ogg": "ogg",
         "audio/opus": "ogg", "audio/mp4": "mp4", "audio/m4a": "mp4", "audio/x-m4a": "mp4",
         "audio/aac": "mp4"}
HERE = Path(__file__).resolve().parent


def conf_path() -> Path:
    return Path(os.environ.get("VOICE_FLOW_CONF")
                or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
                / "ormus-voice" / "voice-flow.conf")


def conf_value(key: str) -> str:
    """The environment wins; else the last KEY=value line of the conf, quotes stripped."""
    if key in os.environ:
        return os.environ[key]
    val = ""
    try:
        for line in conf_path().read_text().splitlines():
            if line.startswith(key + "="):
                val = line[len(key) + 1:].strip().strip('"').strip("'")
    except OSError:
        pass
    return val


def whisper_hosts() -> list[str]:
    return (conf_value("VOICE_PASTE_REMOTE_HOSTS") or "127.0.0.1:8093").split()


def first_engine() -> str | None:
    """First whisper host that answers HTTP at all (whisper-paste uses the same list and order)."""
    for host in whisper_hosts():
        try:
            urllib.request.urlopen(f"http://{host}/", timeout=1).close()
            return host
        except urllib.error.HTTPError:
            return host  # it answered; a 404 on / is still a live server
        except OSError:
            continue
    return None


def default_style() -> str:
    s = conf_value("VOICE_FLOW_EXPRESS") or "prompt"
    return s if s in STYLES else "prompt"


def history_log(style: str, out: dict, ms_total: int, rewrite_on: bool) -> None:
    """One counts-only line, method "api". The text rides along only with VOICE_FLOW_LOG_TEXT=1."""
    text = out.get("text", "")
    path = Path(conf_value("VOICE_FLOW_HISTORY_LOG") or
                Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
                / "ormus-voice" / "history.jsonl")
    rec = {"ts": datetime.now().astimezone().isoformat(timespec="seconds"),
           "words": len(text.split()), "chars": len(text),
           "model": conf_value("VOICE_PASTE_MODEL") or "medium.en", "method": "api",
           "style": style, "rewrite": rewrite_on, "transcribe_ms": out.get("ms", {}).get("transcribe", ms_total),
           "diverted": False}
    if out.get("dropped"):
        rec["dropped"] = out["dropped"]
    if conf_value("VOICE_FLOW_LOG_TEXT") == "1":
        rec["text"] = text
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except OSError:
        pass


class Fail(Exception):
    def __init__(self, status: int, kind: str, message: str):
        self.status, self.kind, self.message = status, kind, message


def to_wav(src: Path, dst: Path) -> None:
    """Any accepted container -> 16 kHz mono PCM16 WAV. ffmpeg refusing it is the validity check."""
    r = subprocess.run(["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", str(src), "-vn",
                        "-ac", "1", "-ar", "16000", "-c:a", "pcm_s16le", str(dst)],
                       capture_output=True, timeout=120)
    if r.returncode != 0 or not dst.exists() or dst.stat().st_size <= 44:
        raise Fail(400, "bad_audio", "the audio could not be decoded")


def dictate(audio: bytes, ext: str, style: str) -> dict:
    engine = first_engine()
    if engine is None:
        raise Fail(503, "no_engine", "no whisper host answers")
    rewrite_on = conf_value("VOICE_FLOW_REWRITE") != "off" and style != "verbatim"
    work = Path(tempfile.mkdtemp(prefix="voice-flow-api-"))
    try:
        src, wav, rep, run = work / f"in.{ext}", work / "take.wav", work / "report", work / "run"
        rep.mkdir()
        (run / "ormus-voice").mkdir(parents=True)
        src.write_bytes(audio)
        to_wav(src, wav)
        env = dict(os.environ)
        env.update({
            "PATH": f"{HERE}:{os.environ.get('PATH', '')}",
            "VOICE_PASTE_QUIET": "1",
            # a private runtime dir: the engine's last-drop and notify files stay out of Super+H's
            "XDG_RUNTIME_DIR": str(run),
            "VOICE_PASTE_REPORT_DIR": str(rep),
            "VOICE_REWRITE_STATUS_FILE": str(rep / "rewrite_status"),
            "VOICE_FLOW_EXPRESS": style,
            "VOICE_PASTE_REWRITE_COMMAND": (os.environ.get("VOICE_PASTE_REWRITE_COMMAND")
                                            or "voice-rewrite-ollama") if rewrite_on else "",
        })
        t0 = time.monotonic()
        p = subprocess.run(["whisper-paste", "--file", str(wav)], env=env, capture_output=True,
                           text=True, timeout=600)
        total = int((time.monotonic() - t0) * 1000)

        def get(name: str) -> str:
            try:
                return (rep / name).read_text()
            except OSError:
                return ""

        if p.returncode != 0:
            raise Fail(502, "no_engine", "the engine failed")
        text = p.stdout.strip()
        used = get("engine") or engine
        raw = get("raw")
        out: dict = {"text": text, "raw": raw, "style": style, "engine": used,
                     "ms": {"transcribe": int(get("transcribe_ms") or total),
                            "rewrite": int(get("rewrite_ms") or 0)}}
        drop = ""
        try:
            drop = (run / "ormus-voice" / "last-drop").read_text().split()[0]
        except (OSError, IndexError):
            pass
        if not text and drop:
            if drop == "empty" and used == "local":
                raise Fail(503, "no_engine", "no whisper host answered during the take")
            out["dropped"] = drop
        elif rewrite_on and (get("rewrite") == "failed" or get("rewrite_status") == "failed"):
            out["rewrite"] = "failed"
        history_log(style, out, total, rewrite_on)
        return out
    finally:
        shutil.rmtree(work, ignore_errors=True)


class Handler(BaseHTTPRequestHandler):
    server_version = "voice-flow-api"

    def log_message(self, fmt, *args):  # no per-request lines: they could carry a query, never text
        pass

    def send(self, status: int, body: dict) -> None:
        data = json.dumps(body, ensure_ascii=False).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def err(self, status: int, kind: str, message: str) -> None:
        self.send(status, {"error": kind, "message": message})

    def do_GET(self):
        if urllib.parse.urlparse(self.path).path != "/v1/health":
            return self.err(404, "not_found", "unknown path")
        engine = first_engine()
        if engine is None:
            return self.err(503, "no_engine", "no whisper host answers")
        self.send(200, {"status": "ok", "engine": engine})

    def do_POST(self):
        url = urllib.parse.urlparse(self.path)
        if url.path != "/v1/dictate":
            return self.err(404, "not_found", "unknown path")
        try:
            q = urllib.parse.parse_qs(url.query)
            style = (q.get("style") or [""])[0] or default_style()
            if style not in STYLES:
                raise Fail(400, "bad_request", "style must be one of " + "|".join(STYLES))
            ctype = (self.headers.get("Content-Type") or "").split(";")[0].strip().lower()
            if ctype not in TYPES:
                raise Fail(415, "bad_audio", "Content-Type must be audio/wav, audio/ogg or audio/mp4")
            try:
                n = int(self.headers.get("Content-Length") or "")
            except ValueError:
                raise Fail(411, "bad_audio", "Content-Length is required")
            limit = int(conf_value("VOICE_FLOW_API_MAX_BYTES") or 60 * 1024 * 1024)
            if n > limit:
                self.close_connection = True
                raise Fail(413, "too_large", f"the upload is over {limit} bytes")
            if n <= 0:
                raise Fail(400, "bad_audio", "empty body")
            audio = self.rfile.read(n)
            if len(audio) != n:
                raise Fail(400, "bad_audio", "the body ended early")
            self.send(200, dictate(audio, TYPES[ctype], style))
        except Fail as f:
            self.err(f.status, f.kind, f.message)
        except subprocess.TimeoutExpired:
            self.err(504, "no_engine", "the pipeline timed out")
        except Exception as e:  # never a bare 500 without the JSON shape
            self.err(500, "internal", type(e).__name__)


def main() -> int:
    port = int(conf_value("VOICE_FLOW_API_PORT") or 8097)
    addrs = (conf_value("VOICE_FLOW_API_BIND") or "127.0.0.1").split()
    servers = [ThreadingHTTPServer((a, port), Handler) for a in addrs]
    for s in servers[1:]:
        threading.Thread(target=s.serve_forever, daemon=True).start()
    print(f"voice-flow-api on {', '.join(f'{a}:{port}' for a in addrs)} "
          f"(no auth: the network you bind to is the gate)", file=sys.stderr, flush=True)
    try:
        servers[0].serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
